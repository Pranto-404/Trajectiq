{
  "name": "trajectiq",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "kit": "vite --open /kit.html",
    "build": "node scripts/build.mjs",
    "build:legacy-standalone": "node scripts/build-standalone.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:node": "node --test tests/*.test.mjs",
    "test:ui": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "fixtures:legacy": "node scripts/export-legacy-saves.mjs",
    "start": "python3 -m http.server 3000 --directory dist",
    "standalone": "node scripts/build-standalone.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "motion": "14.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
